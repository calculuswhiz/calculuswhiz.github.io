{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unexpected-multiline": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "dist/"
  ]
}